---
// src/components/FounderNote.astro
// First-person note from the founder. No photo — an initial badge stands in for it.
import { site } from '../data/site';

interface Props {
  variant?: 'dark' | 'light';
}

const { variant = 'dark' } = Astro.props;
const dark = variant === 'dark';
const initial = site.founderName.charAt(0).toUpperCase();
---

<section class={dark ? 'bg-navy-900 py-14 px-4' : 'section-white'}>
  <div class="max-w-3xl mx-auto">
    <p class="text-cyan-400 text-xs font-bold uppercase tracking-widest mb-3 text-center">A Note From the Founder</p>
    <h2 class={`text-2xl md:text-3xl font-extrabold mb-6 leading-tight text-center ${dark ? 'text-white' : 'text-slate-900'}`}>
      Small on Purpose, So You Always Know Who to Call
    </h2>
    <div class={`flex flex-col gap-4 text-base leading-relaxed ${dark ? 'text-slate-300' : 'text-slate-600'}`}>
      <p>
        I started WiseTech because most small businesses in the GTA get the same deal from IT: something breaks,
        you call someone, you pay by the hour, and it happens again next month.
      </p>
      <p>
        WiseTech works differently. Your systems are monitored and maintained for one flat monthly fee, so problems
        get fixed before they slow your team down — and you always know what you'll pay.
      </p>
      <p>
        We're deliberately small. When you call, you reach the person who set up your systems and knows how they're
        configured — no call centre, no ticket queue, no explaining your setup from scratch. And if we're not the
        right fit for your business, I'll tell you.
      </p>
    </div>
    <div class="flex items-center gap-4 mt-8">
      <div
        class="w-12 h-12 rounded-full bg-cyan-400 text-navy-900 font-extrabold text-xl flex items-center justify-center flex-shrink-0"
        aria-hidden="true"
      >
        {initial}
      </div>
      <div>
        <p class={`font-bold ${dark ? 'text-white' : 'text-slate-900'}`}>{site.founderName}</p>
        <p class="text-sm text-slate-400">{site.founderTitle}</p>
      </div>
    </div>
  </div>
</section>
