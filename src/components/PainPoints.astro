---
// src/components/PainPoints.astro
// "Sound familiar?" — the situations that usually make a business start looking for IT help.

const items = [
  {
    icon: '🚪',
    title: 'Your IT person just left',
    body: 'Or there never really was one. We take over, document what you have, and keep it running.',
    href: '/services/managed-it/',
  },
  {
    icon: '🎣',
    title: 'A suspicious email got through',
    body: 'Phishing is one of the most common ways attackers get in. We lock down email, accounts and devices so one click doesn\'t become a crisis.',
    href: '/services/cybersecurity/',
  },
  {
    icon: '🐢',
    title: 'Tech keeps slowing everyone down',
    body: 'Slow computers, patchy Wi-Fi, printers that won\'t print. We fix the cause, not just the symptom.',
    href: '/services/network-infrastructure/',
  },
  {
    icon: '💾',
    title: 'You\'re not sure your backups work',
    body: 'Many businesses only find out when they need them. We test restores so you know your data can come back.',
    href: '/services/backup-disaster-recovery/',
  },
];
---

<section class="section-slate">
  <div class="container-lg">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3">Sound Familiar?</h2>
      <p class="text-slate-600 max-w-xl mx-auto">Most businesses call us when one of these happens. You don't have to wait for it.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {items.map(item => (
        <a href={item.href} class="card p-6 flex flex-col hover:shadow-md hover:border-cyan-400 transition-all group">
          <div class="text-3xl mb-3" aria-hidden="true">{item.icon}</div>
          <h3 class="font-bold text-slate-900 mb-2 group-hover:text-cyan-600 transition-colors">{item.title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed flex-1">{item.body}</p>
          <span class="text-cyan-500 text-sm font-semibold mt-4">How we help →</span>
        </a>
      ))}
    </div>
  </div>
</section>
