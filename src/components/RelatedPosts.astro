---
// src/components/RelatedPosts.astro
// Links a service/industry page to the blog posts that already link to it,
// so pillar pages pass authority down to their supporting articles.
import { getCollection } from 'astro:content';

interface Props {
  path: string;       // e.g. '/services/cybersecurity'
  title?: string;
  limit?: number;
}

const { path, title = 'Related Guides', limit = 3 } = Astro.props;

const now = new Date();
const linkPattern = new RegExp(`\\]\\(${path}/?[)#]`);
const posts = (await getCollection('blog'))
  .filter(post => post.data.pubDate <= now && linkPattern.test(post.body))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);
---

{posts.length > 0 && (
  <section class="section-slate">
    <div class="container-lg">
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-8">{title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map(post => (
          <a
            href={`/blog/${post.slug}/`}
            class="card flex flex-col overflow-hidden hover:shadow-md hover:border-cyan-400 transition-all group"
          >
            {post.data.heroImage && (
              <img
                src={post.data.heroImage}
                alt=""
                class="w-full h-40 object-cover"
                loading="lazy"
              />
            )}
            <div class="p-5 flex flex-col flex-1 gap-2">
              <span class="text-slate-400 text-xs">{post.data.readTime} min read</span>
              <h3 class="font-bold text-slate-900 leading-snug group-hover:text-cyan-600 transition-colors">
                {post.data.title}
              </h3>
              <span class="text-cyan-500 text-sm font-semibold mt-auto">Read more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
