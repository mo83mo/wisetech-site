---
// src/components/Testimonials.astro
// Renders nothing until src/data/testimonials.ts has real, approved entries.
import { testimonials } from '../data/testimonials';
---

{testimonials.length > 0 && (
  <section class="section-white">
    <div class="container-lg">
      <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-10 text-center">What Clients Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.map(t => (
          <figure class="card p-6 flex flex-col">
            <blockquote class="text-slate-700 leading-relaxed flex-1">“{t.quote}”</blockquote>
            <figcaption class="mt-5 text-sm">
              <span class="font-bold text-slate-900">{t.name}</span>
              {(t.role || t.company) && (
                <span class="block text-slate-500">{[t.role, t.company].filter(Boolean).join(', ')}{t.city ? ` · ${t.city}` : ''}</span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
