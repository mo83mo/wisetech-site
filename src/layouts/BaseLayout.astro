---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  canonicalURL?: string;
  noindex?: boolean;
  additionalSchema?: object | object[];
}

const {
  title,
  description,
  ogImage = 'https://wisetech.ca/images/og-default.jpg',
  ogType = 'website',
  publishedTime,
  canonicalURL = Astro.url.href,
  noindex = false,
  additionalSchema,
} = Astro.props;

const sitelinksSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://wisetech.ca/#website",
  "name": "WiseTech",
  "url": "https://wisetech.ca/",
  "publisher": { "@id": "https://wisetech.ca/#organization" }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "@id": "https://wisetech.ca/#organization",
  "name": "WiseTech",
  "legalName": "WiseTech Inc.",
  "url": "https://wisetech.ca/",
  "telephone": "+1-888-445-9473",
  "email": "Info@wisetech.ca",
  "logo": "https://wisetech.ca/images/logo-white.png",
  "image": "https://wisetech.ca/images/og-default.jpg",
  "sameAs": [
    "https://www.linkedin.com/company/wisetech-inc"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "750-2 Robert Speck Parkway",
    "addressLocality": "Mississauga",
    "addressRegion": "ON",
    "postalCode": "L4Z 1H8",
    "addressCountry": "CA"
  },
  "areaServed": [
    { "@type": "City", "name": "Mississauga" },
    { "@type": "City", "name": "Toronto" },
    { "@type": "City", "name": "Brampton" },
    { "@type": "City", "name": "Oakville" }
  ],
  "priceRange": "$$",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary Meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="WiseTech" />
  <meta property="og:locale" content="en_CA" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Preconnect hints -->
  <link rel="preconnect" href="https://images.unsplash.com" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon-180.png" />

  <!-- WebSite + Sitelinks Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(sitelinksSchema)} />

  <!-- LocalBusiness Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- Additional Schema (Service, FAQ etc.) -->
  {additionalSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(additionalSchema)} />
  )}

  <!-- Google Tag Manager — production domain only, so pages.dev previews and localhost don't pollute GA4 -->
  <script is:inline>if(/(^|\.)wisetech\.ca$/.test(location.hostname)){(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NL2PD7TD');}</script>
  <!-- End Google Tag Manager -->
</head>
<body class="font-sans antialiased bg-white text-slate-700">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NL2PD7TD"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <slot />
  <ChatWidget />
</body>
</html>
